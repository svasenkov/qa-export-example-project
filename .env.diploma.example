# Isolated LOCAL teaching instance. These are not production settings.
# Pass explicitly: docker compose -p qa-diploma --env-file .env.diploma.example ...
BACKEND_GO_STDLIB_PORT=127.0.0.1:18831
BACKEND_GO_STDLIB_MANAGEMENT_PORT=127.0.0.1:18931
FRONTEND_TS_VUE_PORT=127.0.0.1:19813
CI_GATEWAY_PORT=127.0.0.1:19821
MOCK_GATEWAY_PORT=127.0.0.1:19911

# Sonar analysis — see tools/quality/README.md.
# Token is NOT stored here: keep it in ~/.config/sonar/<host>.token
# (chmod 600) and run `. tools/quality/sonar-env.sh` before sonar commands.
# Provider: sonarqube (self-hosted, default https://sonar.qa.guru) or sonarcloud.
# SONAR_PROVIDER=sonarqube
# SONAR_HOST_URL=https://sonar.qa.guru
# SONAR_ORGANIZATION=        # required only for SONAR_PROVIDER=sonarcloud
# SONAR_PROJECT_KEY=         # optional per-module project key override
