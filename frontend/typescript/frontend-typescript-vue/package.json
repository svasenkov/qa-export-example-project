    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "allure-js-commons": "^3.10.2",
    "allure-vitest": "^3.10.2",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
