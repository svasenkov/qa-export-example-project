{
  "priority": 1,
  "request": {
    "method": "GET",
    "url": "/api/auth/me",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "username": "mock-user" }
  }
}
